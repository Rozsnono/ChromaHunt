# Copy to .env.local and fill in. NEVER commit real values.
NODE_ENV=development

# MongoDB (Atlas or any replica set; transactions are required for account deletion)
MONGODB_URI=mongodb://localhost:27017/chromahunt

# Secrets: generate with `openssl rand -base64 48`
JWT_ACCESS_SECRET=
UPLOAD_TOKEN_SECRET=
ADMIN_SESSION_SECRET=
# HMAC key for refresh tokens, invite codes and biometric secrets (rotating it invalidates them)
TOKEN_PEPPER=
# Shared secret the external scheduler sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Admin web panel password (min 12 chars). Change it by editing the environment and redeploying.
ADMIN_PASSWORD=

# Photo storage: `filesharer` (production uploader API), `webdav` (plain WebDAV) or `fs` (local disk, development only)
STORAGE_DRIVER=filesharer
LOCAL_STORAGE_DIR=.data/storage

# File sharer uploader API (server side only, never sent to clients)
FILESHARER_URL=https://api.filesharer.rozsnorbert.hu:9443
FILESHARER_API_KEY=
# Optional sub-directory below the API key's folder (relative, empty = the key folder)
FILESHARER_BASE_PATH=

# WebDAV storage (server side only; required when STORAGE_DRIVER=webdav)
WEBDAV_URL=https://webdav.example.com/remote.php/dav/files/chromahunt
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_BASE_PATH=chromahunt

# Comma separated browser origins allowed to call the API (native apps send no Origin)
CORS_ALLOWED_ORIGINS=
# Public origin of the admin panel, used for the CSRF Origin check
APP_ORIGIN=http://localhost:3000

PRIVACY_POLICY_VERSION=1
# Optional: Expo push access token (enhanced push security)
EXPO_ACCESS_TOKEN=
# debug | info | warn | error
LOG_LEVEL=info
